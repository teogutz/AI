{
  "name": "peakplan-server",
  "version": "1.0.0",
  "description": "PeakPlan sync server + MCP connector for Claude",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "stdio": "node --disable-warning=ExperimentalWarning dist/stdio.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start:local": "node --env-file=.env --disable-warning=ExperimentalWarning dist/index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
